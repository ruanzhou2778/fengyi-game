[
  {"id":1,"type":"争宠","trigger":"宠爱 > 30","description":"皇帝在御花园散步，偶遇你正在赏花。你见机行事，欲借此机会博取圣心。","choices":[{"text":"上前献花，故作娇羞","effects":{"宠爱":[5,15],"威望":[-2,3]}},{"text":"退避行礼，不争不抢","effects":{"宠爱":[2,6],"威望":[2,5]}}]},
